+// The simple API has no disconnect event. Expire silent devices, retaining
+// their identity so cached OpenXR handles remain valid across reconnection.
+static bool
+survive_device_active(struct survive_device *d)
+{
+	uint64_t last = __atomic_load_n(&d->last_event_ns, __ATOMIC_RELAXED);
+	return last != 0 && os_monotonic_get_ns() - last < 2 * U_TIME_1S_IN_NS;
+}
+
 static xrt_result_t
 survive_device_get_tracked_pose(struct xrt_device *xdev,
                                 enum xrt_input_name name,
@@ -229,8 +239,8 @@
