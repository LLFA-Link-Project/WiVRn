+		}
 	}
 
 	os_mutex_unlock(&survive->sys->lock);
@@ -1021,6 +1067,28 @@
                           struct vive_controller_config *config)
 {
 
+	const char *serial = config->firmware.device_serial_number;
+	if (serial[0] != '\0') {
+		for (int i = 0; i < MAX_TRACKED_DEVICE_COUNT; i++) {
+			struct survive_device *existing = sys->controllers[i];
+			if (existing != NULL && strcmp(existing->base.serial, serial) == 0) {
+				if (existing->ctrl.config.variant != config->variant) {
+					return false;
+				}
+				existing->survive_obj = sso;
+				m_relation_history_clear(existing->relation_hist);
+				__atomic_store_n(&existing->last_event_ns, 0, __ATOMIC_RELAXED);
+				for (size_t j = 0; j < existing->num_last_inputs; j++) {
