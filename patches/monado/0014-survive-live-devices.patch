+	if (sys->xsysd && sys->xsysd->static_xdev_count >= XRT_SYSTEM_MAX_DEVICES) {
+		return false;
+	}
+
 	enum VIVE_CONTROLLER_VARIANT variant = config->variant;
 
 	int idx = -1;
@@ -1187,6 +1255,13 @@
 
 	u_var_add_root(survive, "Survive Device", true);
 
