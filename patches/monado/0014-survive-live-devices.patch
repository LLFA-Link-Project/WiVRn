@@ -729,8 +754,23 @@
 add_device(struct survive_system *ss, const struct SurviveSimpleConfigEvent *e);
 
 static void
+survive_device_mark_active(struct survive_device *d)
+{
+	if (!survive_device_active(d)) {
+		for (size_t i = 0; i < d->num_last_inputs; i++) {
+			memset(&d->last_inputs[i].value, 0, sizeof(d->last_inputs[i].value));
+		}
+		if (d->device_type == DEVICE_TYPE_CONTROLLER) {
+			memset(d->ctrl.curl, 0, sizeof(d->ctrl.curl));
+		}
+	}
+	__atomic_store_n(&d->last_event_ns, os_monotonic_get_ns(), __ATOMIC_RELAXED);
+}
+
+static void
 _process_pose_event(struct survive_device *survive, const struct SurviveSimplePoseUpdatedEvent *e)
 {
+	survive_device_mark_active(survive);
 	struct xrt_space_relation rel = {0};
 	pose_to_relation(&e->pose, &e->velocity, &rel);
 	timepoint_ns ts = survive_timecode_to_monotonic(survive, e->time);
@@ -752,6 +792,7 @@
