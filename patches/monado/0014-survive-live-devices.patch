From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenAI Codex <codex@openai.com>
Date: Sat, 24 Oct 2026 00:00:00 +0000
Subject: [PATCH] survive: publish live devices and retain identities across reconnects

---
diff --git a/src/xrt/drivers/survive/survive_interface.h b/src/xrt/drivers/survive/survive_interface.h
--- a/src/xrt/drivers/survive/survive_interface.h
+++ b/src/xrt/drivers/survive/survive_interface.h
@@ -29,6 +29,29 @@
 int
 survive_get_devices(struct xrt_prober *xp, struct xrt_device **out_xdevs, struct vive_config **out_vive_config);
 
+struct xrt_system_devices;
+struct xrt_system_roles;
+struct survive_system;
+
+/* WiVRn owns the context independently of devices, including an empty system.
+ * Start publication only after the space overseer has been created.
+ * Stop before destroying devices; destroy the system after destroying devices.
+ */
+struct survive_system *
+survive_create_devices(struct xrt_system_devices *xsysd);
+
+void
+survive_start(struct survive_system *sys, void (*device_added)(struct xrt_device *, void *), void *userdata);
+
+void
+survive_stop(struct survive_system *sys);
+
+void
+survive_destroy(struct survive_system *sys);
+
+void
+survive_get_roles(struct survive_system *sys, struct xrt_system_roles *out_roles);
+
 #ifdef __cplusplus
 }
 #endif
