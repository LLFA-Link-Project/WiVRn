+			U_LOG_IFL_W(ss->log_level, "Skipping survive device without a stable serial");
+			return;
+		}
 
 		switch (config.variant) {
 		case CONTROLLER_VIVE_WAND:
@@ -1309,7 +1393,9 @@
 
 		// one event queue for all devices. _process_events() updates all devices
 		struct SurviveSimpleEvent event = {0};
-		survive_simple_wait_for_event(ss->ctx, &event);
+		if (survive_simple_next_event(ss->ctx, &event) == SurviveSimpleEventType_None) {
+			os_nanosleep(U_TIME_1MS_IN_NS);
+		}
 
 		os_mutex_lock(&ss->lock);
 		_process_event(ss, &event);
@@ -1324,8 +1410,9 @@
 	return NULL;
 }
 
-int
-survive_get_devices(struct xrt_prober *xp, struct xrt_device **out_xdevs, struct vive_config **out_vive_config)
+static int
+survive_get_devices_internal(struct xrt_prober *xp, struct xrt_device **out_xdevs, struct vive_config **out_vive_config,
+                             bool system_owned, struct survive_system **out_system)
 {
 	SurviveSimpleContext *actx = NULL;
 #if 1
@@ -1354,6 +1441,7 @@
 	survive_simple_start_thread(actx);
 
 	ss->ctx = actx;
+	ss->system_owned = system_owned;
 	ss->base.type = XRT_TRACKING_TYPE_LIGHTHOUSE;
 	snprintf(ss->base.name, XRT_TRACKING_NAME_LEN, "%s", "Libsurvive Tracking");
 	ss->base.initial_offset.position.x = 0.0f;
@@ -1419,7 +1507,7 @@
 		}
 	}
 
-	if (out_idx == 0) {
+	if (out_idx == 0 && !system_owned) {
 		os_thread_helper_destroy(&ss->event_thread);
 		os_mutex_destroy(&ss->lock);
 		survive_simple_close(ss->ctx);
@@ -1427,7 +1515,7 @@
 		return 0;
 	}
 
-	ret = os_thread_helper_start(&ss->event_thread, run_event_thread, ss);
+	ret = system_owned ? 0 : os_thread_helper_start(&ss->event_thread, run_event_thread, ss);
 	if (ret != 0) {
 		U_LOG_IFL_E(ss->log_level, "Failed to start event thread!");
 		for (int i = 0; i < out_idx; i++) {
@@ -1440,5 +1528,97 @@
 	u_var_add_root(ss, "Survive system", true);
 	u_var_add_draggable_f32(ss, &ss->timecode_offset_ms, "Timecode offset(ms)");
 
+	if (out_system != NULL) {
+		*out_system = ss;
+	}
 	return out_idx;
 }
+
+int
+survive_get_devices(struct xrt_prober *xp, struct xrt_device **out_xdevs, struct vive_config **out_vive_config)
+{
+	return survive_get_devices_internal(xp, out_xdevs, out_vive_config, false, NULL);
+}
+
+struct survive_system *
+survive_create_devices(struct xrt_system_devices *xsysd)
+{
+	struct survive_system *ss = NULL;
+	struct xrt_device *devices[XRT_MAX_DEVICES_PER_PROBE] = {0};
+	struct vive_config *config = NULL;
+	int count = survive_get_devices_internal(NULL, devices, &config, true, &ss);
+	if (ss == NULL) {
+		return NULL;
+	}
+	ss->xsysd = xsysd;
+	for (int i = 0; i < count; i++) {
+		if (xsysd->static_xdev_count < XRT_SYSTEM_MAX_DEVICES) {
+			xsysd->static_xdevs[xsysd->static_xdev_count++] = devices[i];
+		} else {
+			xrt_device_destroy(&devices[i]);
+		}
+	}
+	return ss;
+}
+
+void
+survive_start(struct survive_system *ss, void (*device_added)(struct xrt_device *, void *), void *userdata)
+{
+	if (ss == NULL) {
+		return;
+	}
+	ss->device_added = device_added;
+	ss->device_added_userdata = userdata;
+	if (os_thread_helper_start(&ss->event_thread, run_event_thread, ss) != 0) {
+		U_LOG_E("Failed to start survive event thread");
+	}
+}
+
+void
+survive_stop(struct survive_system *ss)
+{
+	if (ss != NULL) {
+		os_thread_helper_stop_and_wait(&ss->event_thread);
+	}
+}
+
+void
+survive_destroy(struct survive_system *ss)
+{
+	if (ss == NULL) {
+		return;
+	}
+	survive_stop(ss);
+	os_thread_helper_destroy(&ss->event_thread);
+	u_var_remove_root(ss);
+	survive_simple_close(ss->ctx);
+	os_mutex_destroy(&ss->lock);
+	free(ss);
+}
+
+void
+survive_get_roles(struct survive_system *ss, struct xrt_system_roles *out_roles)
+{
+	*out_roles = (struct xrt_system_roles)XRT_SYSTEM_ROLES_INIT;
+	if (ss == NULL) {
+		return;
+	}
+	os_mutex_lock(&ss->lock);
+	uint32_t count = __atomic_load_n(&ss->xsysd->static_xdev_count, __ATOMIC_ACQUIRE);
+	for (uint32_t i = 0; i < count; i++) {
+		struct xrt_device *xdev = ss->xsysd->static_xdevs[i];
+		if (xdev->tracking_origin != &ss->base || !survive_device_active((struct survive_device *)xdev)) {
+			continue;
+		}
+		if ((xdev->device_type == XRT_DEVICE_TYPE_LEFT_HAND_CONTROLLER ||
+		     xdev->device_type == XRT_DEVICE_TYPE_ANY_HAND_CONTROLLER) && out_roles->left < 0) {
+			out_roles->left = i;
+			out_roles->left_profile = xdev->name;
+		} else if ((xdev->device_type == XRT_DEVICE_TYPE_RIGHT_HAND_CONTROLLER ||
+		            xdev->device_type == XRT_DEVICE_TYPE_ANY_HAND_CONTROLLER) && out_roles->right < 0) {
+			out_roles->right = i;
+			out_roles->right_profile = xdev->name;
+		}
+	}
+	os_mutex_unlock(&ss->lock);
+}
