+		uint32_t count = sys->xsysd->static_xdev_count;
+		sys->xsysd->static_xdevs[count] = &survive->base;
+		__atomic_store_n(&sys->xsysd->static_xdev_count, count + 1, __ATOMIC_RELEASE);
+	}
+
 	return true;
 }
 
@@ -1206,12 +1281,21 @@
 	char *conf_str = (char *)survive_simple_json_config(sso);
 
 	if (type == SurviveSimpleObject_HMD) {
