From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenAI Codex <codex@openai.com>
Date: Mon, 12 Oct 2026 20:00:00 +0900
Subject: [PATCH] d/steamvr_lh: finalize reference recorder before session shutdown

Expose an idempotent finish operation so the embedding server can join and
flush the writer before closing USB capture and sealing session metadata.
Disable callback publication during shutdown. Preserve destructor cleanup.

---

diff --git a/src/xrt/drivers/steamvr_lh/reference_recorder.cpp b/src/xrt/drivers/steamvr_lh/reference_recorder.cpp
index cf372e5c5..b41dcb498 100644
--- a/src/xrt/drivers/steamvr_lh/reference_recorder.cpp
+++ b/src/xrt/drivers/steamvr_lh/reference_recorder.cpp
@@ -277,6 +277,11 @@ namespace {
 			}
 		}
 		~Recorder()
+		{
+			finish();
+		}
+		void
+		finish() noexcept
 		{
 			accepting = false;
 			shutdown = true;
@@ -338,6 +343,13 @@ initialize() noexcept
 {
 	instance.store(&recorder(), std::memory_order_release);
 }
+void
+finish() noexcept
+{
+	auto r = instance.exchange(nullptr, std::memory_order_acq_rel);
+	if (r)
+		r->finish();
+}
 int64_t
 capture_time() noexcept
 {
diff --git a/src/xrt/drivers/steamvr_lh/reference_recorder.hpp b/src/xrt/drivers/steamvr_lh/reference_recorder.hpp
index 5209f83c2..c5deb2cda 100644
--- a/src/xrt/drivers/steamvr_lh/reference_recorder.hpp
+++ b/src/xrt/drivers/steamvr_lh/reference_recorder.hpp
@@ -3,9 +3,12 @@
 #include "openvr_driver.h"
 #include <cstdint>
 namespace lighthouse_reference {
-// Initialization belongs to discovery, never the high-rate pose callback.
+// Initialize during startup/discovery, never the high-rate pose callback.
+// Finish after Valve callbacks are stopped, before session metadata is finalized.
 void
 initialize() noexcept;
+void
+finish() noexcept;
 int64_t
 capture_time() noexcept; // zero when disabled
 void
