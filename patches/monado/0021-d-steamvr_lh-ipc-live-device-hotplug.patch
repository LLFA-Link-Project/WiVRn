+Device *
+Context::device_from_xdev_locked(struct xrt_device *xdev)
+{
+	if (xdev == nullptr) {
+		return nullptr;
+	}
+	if (this->hmd != nullptr && xdev == this->hmd) {
+		return this->hmd;
+	}
+	for (ControllerDevice *controller : this->controller) {
+		if (controller != nullptr && xdev == controller) {
+			return controller;
+		}
+	}
+	return nullptr;
+}
