+// Copyright 2026, OpenAI
+// SPDX-License-Identifier: BSL-1.0
+#pragma once
+#include "xrt/xrt_defines.h"
+#include <array>
+#include <cstdint>
+#include <string>
+#include <utility>
+
+// All calls are serialized by Context::devices_mut. Corrections are applied to
+// samples before history insertion, never to a prediction using today's base pose.
+class BaseStationStabilizer
+{
+public:
+	explicit BaseStationStabilizer(std::string serial = {}) : serial(std::move(serial)) {}
+	const std::string serial;
+	bool
+	enabled() const
+	{
+		return !serial.empty();
+	}
+	struct Result
+	{
+		const char *state{"disabled"};
+		bool applied{false};
+		xrt_pose correction = XRT_POSE_IDENTITY;
+		int64_t reference_time_ns{0};
+	};
+	void
+	observe(const xrt_pose &base, const xrt_pose &world, bool valid, int64_t time_ns, int64_t capture_ns);
+	Result
+	apply(xrt_space_relation &relation, const xrt_pose &world, int64_t time_ns, int64_t capture_ns) const;
+
+private:
+	struct Epoch
+	{
+		xrt_pose world, base, correction;
+		int64_t time_ns, capture_ns;
+	};
+	std::array<Epoch, 64> epochs{};
+	size_t count{0}, next{0};
+	xrt_pose reference_in_driver = XRT_POSE_IDENTITY;
+	bool reference_valid{false}, inconsistent{false};
+	int64_t last_observation_ns{0}, last_valid_capture_ns{0};
+};
