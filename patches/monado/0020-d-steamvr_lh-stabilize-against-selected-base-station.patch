diff --git a/src/xrt/drivers/steamvr_lh/base_station_stabilizer.cpp b/src/xrt/drivers/steamvr_lh/base_station_stabilizer.cpp
new file mode 100644
index 000000000..4f3136d0b
--- /dev/null
+++ b/src/xrt/drivers/steamvr_lh/base_station_stabilizer.cpp
@@ -0,0 +1,120 @@
+// Copyright 2026, OpenAI
+// SPDX-License-Identifier: BSL-1.0
+#include "base_station_stabilizer.hpp"
+#include "math/m_api.h"
+#include <algorithm>
+#include <cmath>
+
+namespace {
+bool
+valid_pose(const xrt_pose &p)
+{
+	const auto &q = p.orientation;
+	const float norm = q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w;
+	return std::isfinite(p.position.x) && std::isfinite(p.position.y) && std::isfinite(p.position.z) &&
+	       std::isfinite(norm) && std::abs(norm - 1.f) < 0.002f;
+}
+float
+position_distance(const xrt_pose &a, const xrt_pose &b)
+{
+	float x = a.position.x - b.position.x, y = a.position.y - b.position.y, z = a.position.z - b.position.z;
+	return std::sqrt(x * x + y * y + z * z);
+}
+float
+quaternion_distance(const xrt_pose &a, const xrt_pose &b)
+{
+	const auto &q = a.orientation;
+	const auto &r = b.orientation;
+	// Antipodal quaternions encode the same rotation.
+	float sign = q.x * r.x + q.y * r.y + q.z * r.z + q.w * r.w < 0 ? -1.f : 1.f;
+	float x = q.x - sign * r.x, y = q.y - sign * r.y, z = q.z - sign * r.z, w = q.w - sign * r.w;
+	return std::sqrt(x * x + y * y + z * z + w * w);
+}
+bool
+same_world(const xrt_pose &a, const xrt_pose &b)
+{
+	// This is an explicit coordinate-generation guard, not a tracking noise filter.
+	return position_distance(a, b) < 1e-5f && quaternion_distance(a, b) < 1e-5f;
+}
+} // namespace
+
+void
+BaseStationStabilizer::observe(
+    const xrt_pose &base, const xrt_pose &world, bool valid, int64_t time_ns, int64_t capture_ns)
+{
+	if (!enabled() || capture_ns < last_observation_ns)
+		return;
+	if (count && time_ns > 0 && time_ns < epochs[(next + epochs.size() - 1) % epochs.size()].time_ns)
+		return;
+	last_observation_ns = capture_ns;
+	reference_valid = valid && time_ns > 0 && valid_pose(base) && valid_pose(world);
+	if (!reference_valid || inconsistent)
+		return;
+	xrt_pose inverse_world, local;
+	math_pose_invert(&world, &inverse_world);
+	math_pose_transform(&inverse_world, &base, &local);
+	if (count == 0) {
+		reference_in_driver = local;
+	} else if (position_distance(reference_in_driver, local) > .05f ||
+	           quaternion_distance(reference_in_driver, local) > .02618f) {
+		// About 5 cm / 3 degrees outside the common world transform: a moved
+		// reference or non-rigid re-estimation must not be silently normalized.
+		inconsistent = true;
+		return;
+	}
+	last_valid_capture_ns = capture_ns;
+	if (count) {
+		const auto &last = epochs[(next + epochs.size() - 1) % epochs.size()];
+		if (time_ns < last.time_ns)
+			return;
+		if (same_world(last.world, world) && position_distance(last.base, base) < 1e-6f &&
+		    quaternion_distance(last.base, base) < 1e-6f)
+			return; // Static bases may announce the same pose very rarely.
+	}
+	auto &epoch = epochs[next];
+	epoch = {world, base, {}, time_ns, capture_ns};
+	// Canonical BS origin/axes: same convention after restart, no per-boot B_ref.
+	math_pose_invert(&base, &epoch.correction);
+	next = (next + 1) % epochs.size();
+	count = std::min(count + 1, epochs.size());
+}
+
+BaseStationStabilizer::Result
+BaseStationStabilizer::apply(xrt_space_relation &relation,
+                             const xrt_pose &world,
+                             int64_t time_ns,
+                             int64_t capture_ns) const
+{
+	Result result;
+	if (!enabled())
+		return result;
+	result.state =
+	    inconsistent ? "reference_changed" : (count ? "waiting_for_matching_reference" : "waiting_for_reference");
+	if (!inconsistent && valid_pose(world) && time_ns > 0) {
+		for (size_t i = 0; i < count; ++i) {
+			const auto &epoch = epochs[(next + epochs.size() - 1 - i) % epochs.size()];
+			if (epoch.time_ns > time_ns || epoch.capture_ns > capture_ns || !same_world(epoch.world, world))
+				continue;
+			// A newer reference observed by this callback supersedes old generations.
+			// Historical samples remain eligible by their own timestamps.
+			const auto &latest = epochs[(next + epochs.size() - 1) % epochs.size()];
+			if (time_ns >= latest.time_ns && !same_world(latest.world, world))
+				break;
+			result.state =
+			    reference_valid && capture_ns - last_valid_capture_ns <= 1000000000LL ? "tracking" : "held";
+			result.applied = true;
+			result.correction = epoch.correction;
+			result.reference_time_ns = epoch.time_ns;
+			math_pose_transform(&epoch.correction, &relation.pose, &relation.pose);
+			math_quat_rotate_vec3(&epoch.correction.orientation, &relation.linear_velocity,
+			                      &relation.linear_velocity);
+			math_quat_rotate_vec3(&epoch.correction.orientation, &relation.angular_velocity,
+			                      &relation.angular_velocity);
+			return result;
+		}
+	}
+	// Never publish a valid uncorrected pose while waiting; no automatic fallback
+	// to a different base or to the unnormalized coordinate system.
+	relation = XRT_SPACE_RELATION_ZERO;
+	return result;
+}
