diff --git a/tests/tests_steamvr_lh_stabilization.cpp b/tests/tests_steamvr_lh_stabilization.cpp
new file mode 100644
index 000000000..6e131be43
--- /dev/null
+++ b/tests/tests_steamvr_lh_stabilization.cpp
@@ -0,0 +1,272 @@
+// Copyright 2026, OpenAI
+// SPDX-License-Identifier: BSL-1.0
+#include "base_station_stabilizer.hpp"
+#include "device.hpp"
+#include "math/m_api.h"
+#include "math/m_relation_history.h"
+#include <cmath>
+#include <iostream>
+#include <cstdlib>
+#include <cstring>
+
+#define CHECK(x)                                                                                                       \
+	do {                                                                                                           \
+		if (!(x)) {                                                                                            \
+			std::cerr << __LINE__ << ": " #x "\n";                                                         \
+			std::abort();                                                                                  \
+		}                                                                                                      \
+	} while (0)
+xrt_pose
+compose(xrt_pose a, xrt_pose b)
+{
+	xrt_pose c;
+	math_pose_transform(&a, &b, &c);
+	return c;
+}
+xrt_pose
+inverse(xrt_pose a)
+{
+	xrt_pose b;
+	math_pose_invert(&a, &b);
+	return b;
+}
+xrt_space_relation
+relation(xrt_pose p)
+{
+	xrt_space_relation r{};
+	r.pose = p;
+	r.relation_flags = static_cast<xrt_space_relation_flags>(
+	    XRT_SPACE_RELATION_ORIENTATION_VALID_BIT | XRT_SPACE_RELATION_POSITION_VALID_BIT |
+	    XRT_SPACE_RELATION_LINEAR_VELOCITY_VALID_BIT | XRT_SPACE_RELATION_ANGULAR_VELOCITY_VALID_BIT);
+	r.linear_velocity = {1, 2, 3};
+	r.angular_velocity = {3, 1, 2};
+	return r;
+}
+void
+near(float a, float b)
+{
+	CHECK(std::abs(a - b) < 1e-4f);
+}
+void
+same(xrt_pose a, xrt_pose b)
+{
+	near(a.position.x, b.position.x);
+	near(a.position.y, b.position.y);
+	near(a.position.z, b.position.z);
+	const float sign = a.orientation.x * b.orientation.x + a.orientation.y * b.orientation.y +
+	                               a.orientation.z * b.orientation.z + a.orientation.w * b.orientation.w <
+	                           0
+	                       ? -1.f
+	                       : 1.f;
+	near(a.orientation.x, sign * b.orientation.x);
+	near(a.orientation.y, sign * b.orientation.y);
+	near(a.orientation.z, sign * b.orientation.z);
+	near(a.orientation.w, sign * b.orientation.w);
+}
+void
+tests()
+{
+	const float h = std::sqrt(.5f);
+	const xrt_pose world{{0, 0, h, h}, {2, 3, 1}}, local_base{{h, 0, 0, h}, {1, 0, 0}},
+	    local_tracker{{0, h, 0, h}, {4, 1, -2}};
+	const auto base = compose(world, local_base), tracker = compose(world, local_tracker);
+	const auto expected = compose(inverse(base), tracker);
+	auto r = relation(tracker);
+	BaseStationStabilizer disabled;
+	CHECK(!disabled.apply(r, world, 101, 101).applied);
+	same(r.pose, tracker);
+	BaseStationStabilizer s("reference-A");
+	r = relation(tracker);
+	CHECK(!s.apply(r, world, 101, 101).applied);
+	CHECK(r.relation_flags == 0);
+	s.observe(base, world, false, 100, 100);
+	r = relation(tracker);
+	CHECK(!s.apply(r, world, 101, 101).applied);
+	s.observe(base, world, true, 100, 100);
+	r = relation(tracker);
+	CHECK(s.apply(r, world, 101, 101).applied);
+	same(r.pose, expected);
+	const auto corrected0 = r;
+	// A pure change of output coordinates must cancel for pose AND both velocities.
+	const xrt_pose change{{0, h, 0, h}, {10, -4, 3}};
+	const auto world2 = compose(change, world), base2 = compose(change, base), tracker2 = compose(change, tracker);
+	r = relation(tracker2);
+	CHECK(!s.apply(r, world2, 190, 190).applied);
+	CHECK(r.relation_flags == 0);
+	s.observe(base2, world2, true, 200, 210);
+	r = relation(tracker2);
+	CHECK(!s.apply(r, world2, 199, 220).applied); // past sample cannot use future base
+	r = relation(tracker);
+	CHECK(s.apply(r, world, 190, 220).applied);
+	same(r.pose, expected); // own old epoch
+	r = relation(tracker);
+	CHECK(!s.apply(r, world, 201, 220).applied); // old generation after switch
+	r = relation(tracker2);
+	auto velocity = r.linear_velocity, angular = r.angular_velocity;
+	math_quat_rotate_vec3(&change.orientation, &velocity, &r.linear_velocity);
+	math_quat_rotate_vec3(&change.orientation, &angular, &r.angular_velocity);
+	CHECK(s.apply(r, world2, 220, 220).applied);
+	same(r.pose, expected);
+	near(r.linear_velocity.x, corrected0.linear_velocity.x);
+	near(r.linear_velocity.y, corrected0.linear_velocity.y);
+	near(r.linear_velocity.z, corrected0.linear_velocity.z);
+	near(r.angular_velocity.x, corrected0.angular_velocity.x);
+	near(r.angular_velocity.y, corrected0.angular_velocity.y);
+	near(r.angular_velocity.z, corrected0.angular_velocity.z);
+	// Interpolation operates on already normalized history and cannot mix coordinate frames.
+	m_relation_history *history{};
+	m_relation_history_create(&history);
+	CHECK(m_relation_history_push(history, &corrected0, 101));
+	CHECK(m_relation_history_push(history, &r, 220));
+	xrt_space_relation interpolated{};
+	m_relation_history_get(history, 150, &interpolated);
+	same(interpolated.pose, expected);
+	m_relation_history_destroy(&history);
+	s.observe(base2, world2, false, 230, 230);
+	r = relation(tracker2);
+	auto held = s.apply(r, world2, 231, 231);
+	CHECK(held.applied && std::strcmp(held.state, "held") == 0);
+	same(r.pose, expected);
+	// Low-rate bases retain their transform without falsely claiming a current observation.
+	s.observe(base2, world2, true, 240, 240);
+	r = relation(tracker2);
+	held = s.apply(r, world2, 2000000241LL, 2000000241LL);
+	CHECK(held.applied && std::strcmp(held.state, "held") == 0);
+	// Restart with same base convention yields the same result (no new B_ref at startup).
+	BaseStationStabilizer restarted("reference-A");
+	restarted.observe(base2, world2, true, 300, 300);
+	r = relation(tracker2);
+	CHECK(restarted.apply(r, world2, 310, 310).applied);
+	same(r.pose, expected);
+	// Reject malformed reference quaternions and future observations.
+	BaseStationStabilizer bad("reference-A");
+	auto malformed = base;
+	malformed.orientation = {0, 0, 0, 0};
+	bad.observe(malformed, world, true, 100, 100);
+	r = relation(tracker);
+	CHECK(!bad.apply(r, world, 110, 110).applied);
+	bad.observe(base, world, true, 300, 300);
+	r = relation(tracker);
+	CHECK(!bad.apply(r, world, 310, 299).applied);
+	// Physical reference movement outside the world transform latches an explicit failure.
+	auto moved_local = local_base;
+	moved_local.position.x += .06f;
+	restarted.observe(compose(world2, moved_local), world2, true, 320, 320);
+	r = relation(tracker2);
+	auto rejected = restarted.apply(r, world2, 330, 330);
+	CHECK(!rejected.applied && std::strcmp(rejected.state, "reference_changed") == 0 && r.relation_flags == 0);
+	restarted.observe(base2, world2, true, 340, 340);
+	r = relation(tracker2);
+	CHECK(!restarted.apply(r, world2, 350, 350).applied);
+	// Quaternion sign changes are the same generation, not reference movement.
+	auto flipped = world;
+	flipped.orientation = {-world.orientation.x, -world.orientation.y, -world.orientation.z, -world.orientation.w};
+	BaseStationStabilizer antipodal("reference-A");
+	antipodal.observe(base, world, true, 100, 100);
+	r = relation(tracker);
+	CHECK(antipodal.apply(r, flipped, 110, 110).applied);
+	same(r.pose, expected);
+	std::cout << "stabilization math, generations, history, velocities, loss, restart and changed-reference checks "
+	             "passed\n";
+}
+// Verify the real Device history and prediction path, not only the math helper.
+class TestDevice final : public Device
+{
+public:
+	explicit TestDevice(const DeviceBuilder &builder) : Device(builder) {}
+	xrt_result_t
+	get_tracked_pose(xrt_input_name, uint64_t t, xrt_space_relation *r) override
+	{
+		get_pose(t, r);
+		return XRT_SUCCESS;
+	}
+};
+void
+device_history_test()
+{
+	setenv("LH_STABILIZE_REFERENCE_SERIAL", "reference-A", 1);
+	auto context = Context::create("/nonexistent-lh-test", "/nonexistent-lh-test", {});
+	CHECK(context);
+	TestDevice device(DeviceBuilder{context, nullptr, "test-tracker", "/nonexistent-lh-test",
+	                                vr::TrackedDeviceClass_GenericTracker});
+	const float h = std::sqrt(.5f);
+	const xrt_pose world{{0, 0, h, h}, {2, 3, 1}}, local_base{{h, 0, 0, h}, {1, 0, 0}},
+	    local_tracker{{0, h, 0, h}, {4, 1, -2}};
+	const xrt_pose change{{0, h, 0, h}, {10, -4, 3}};
+	const auto base = compose(world, local_base), world2 = compose(change, world);
+	const auto expected = compose(inverse(base), compose(world, local_tracker));
+	auto push = [&](xrt_pose w, int64_t t) {
+		vr::DriverPose_t p{};
+		p.qRotation = {local_tracker.orientation.w, local_tracker.orientation.x, local_tracker.orientation.y,
+		               local_tracker.orientation.z};
+		p.vecPosition[0] = local_tracker.position.x;
+		p.vecPosition[1] = local_tracker.position.y;
+		p.vecPosition[2] = local_tracker.position.z;
+		p.qDriverFromHeadRotation.w = 1;
+		p.qWorldFromDriverRotation = {w.orientation.w, w.orientation.x, w.orientation.y, w.orientation.z};
+		p.vecWorldFromDriverTranslation[0] = w.position.x;
+		p.vecWorldFromDriverTranslation[1] = w.position.y;
+		p.vecWorldFromDriverTranslation[2] = w.position.z;
+		p.poseIsValid = p.deviceIsConnected = true;
+		p.result = vr::TrackingResult_Running_OK;
+		std::lock_guard lk(context->devices_mut);
+		device.update_pose(p, 1, t);
+	};
+	context->stabilizer.observe(base, world, true, 1000000000LL, 1000000000LL);
+	push(world, 1001000000LL);
+	push(world2, 1008000000LL); // tracker updates before the new BS
+	context->stabilizer.observe(compose(change, base), world2, true, 1010000000LL, 1010000000LL);
+	push(world2, 1011000000LL);
+	xrt_space_relation r{};
+	device.get_pose(1001000000LL, &r);
+	CHECK(r.relation_flags != 0);
+	same(r.pose, expected);
+	device.get_pose(1009000000LL, &r);
+	CHECK(r.relation_flags == 0);
+	device.get_pose(1012000000LL, &r);
+	CHECK(r.relation_flags != 0);
+	same(r.pose, expected);
+	unsetenv("LH_STABILIZE_REFERENCE_SERIAL");
+}
+void
+read_pose(xrt_pose &p)
+{
+	std::cin >> p.position.x >> p.position.y >> p.position.z >> p.orientation.x >> p.orientation.y >>
+	    p.orientation.z >> p.orientation.w;
+}
+void
+print_pose(const xrt_pose &p)
+{
+	std::cout << ' ' << p.position.x << ' ' << p.position.y << ' ' << p.position.z << ' ' << p.orientation.x << ' '
+	          << p.orientation.y << ' ' << p.orientation.z << ' ' << p.orientation.w;
+}
+int
+main(int argc, char **argv)
+{
+	if (argc == 1) {
+		tests();
+		device_history_test();
+		return 0;
+	}
+	CHECK(argc == 2 && std::strcmp(argv[1], "replay") == 0);
+	BaseStationStabilizer s("reference-A");
+	std::cout.precision(9);
+	int reference, valid;
+	int64_t time, capture;
+	while (std::cin >> reference >> valid >> time >> capture) {
+		xrt_pose p, w;
+		read_pose(p);
+		read_pose(w);
+		CHECK(std::cin.good());
+		auto r = relation(p);
+		if (!valid)
+			r.relation_flags = static_cast<xrt_space_relation_flags>(0);
+		if (reference)
+			s.observe(p, w, valid, time, capture);
+		auto result = s.apply(r, w, time, capture);
+		std::cout << capture << ' ' << reference << ' ' << result.state << ' ' << result.applied << ' '
+		          << r.relation_flags;
+		print_pose(r.pose);
+		std::cout << '\n';
+	}
+}
