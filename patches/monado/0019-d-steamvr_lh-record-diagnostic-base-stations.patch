 void
-Device::update_pose(const vr::DriverPose_t &newPose) const
+Device::update_pose(const vr::DriverPose_t &newPose, uint32_t index, int64_t capture_ns) const
 {
 	xrt_space_relation relation = {};
 
@@ -1269,6 +1273,29 @@ Device::update_pose(const vr::DriverPose_t &newPose) const
 	math_quat_rotate_vec3(&chaperone.orientation, &relation.linear_velocity, &relation.linear_velocity);
 	math_quat_rotate_vec3(&chaperone.orientation, &relation.angular_velocity, &relation.angular_velocity);
 
+	// Snapshot the exact pre-calibration composition used by this callback. File
+	// serialization and compression stay on the recorder's bounded writer queue.
+	if (capture_ns) {
+		lighthouse_reference::PoseContext metadata{};
+		metadata.device_class = int(recording_class);
+		const auto &p = relation.pose;
+		metadata.composed = {p.position.x,    p.position.y,    p.position.z,   p.orientation.x,
+		                     p.orientation.y, p.orientation.z, p.orientation.w};
+		metadata.chaperone = {chaperone.position.x,    chaperone.position.y,    chaperone.position.z,
+		                      chaperone.orientation.x, chaperone.orientation.y, chaperone.orientation.z,
+		                      chaperone.orientation.w};
+		auto universe = properties.find(vr::Prop_CurrentUniverseId_Uint64);
+		if (universe != properties.end() && universe->second.tag == vr::k_unUint64PropertyTag &&
+		    universe->second.buffer.size() == sizeof(uint64_t)) {
+			std::memcpy(&metadata.universe, universe->second.buffer.data(), sizeof(metadata.universe));
+		}
+		lighthouse_reference::pose(serial, index, newPose, capture_ns, &metadata);
+	}
+
+	// References are recorded at their callback time and are never predicted or published.
+	if (recording_class == vr::TrackedDeviceClass_TrackingReference)
+		return;
+
 	const int64_t ts = chrono_timestamp_ns() + time_s_to_ns(newPose.poseTimeOffset);
 
