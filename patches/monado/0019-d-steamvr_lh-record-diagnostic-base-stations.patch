+bool
+Context::setup_tracking_reference(const char *serial, vr::ITrackedDeviceServerDriver *driver)
+{
+	static_assert(reference_index_begin == MAX_CONTROLLERS + 1);
+	static_assert(reference_index_begin + max_tracking_references <= vr::k_unMaxTrackedDeviceCount);
+	if (!serial || !driver || std::strlen(serial) >= XRT_DEVICE_NAME_LEN)
+		return false;
+	uint32_t slot;
+	TrackingReferenceDevice *device;
+	{
+		std::lock_guard lk(devices_mut);
+		for (const auto &reference : references) {
+			if (reference &&
+			    (std::strcmp(reference->serial, serial) == 0 || reference->reference_driver == driver)) {
+				CTX_WARN("Duplicate tracking reference: %s", serial);
+				return false;
+			}
+		}
+		if (next_reference_slot == references.size()) {
+			CTX_WARN("Tracking reference limit reached (%zu)", references.size());
+			return false;
+		}
+		slot = next_reference_slot++;
+		// Context owns the reference. Borrowing it here avoids a shared_ptr cycle.
+		auto borrowed_context = std::shared_ptr<Context>(this, [](Context *) {});
+		references[slot] = std::make_unique<TrackingReferenceDevice>(DeviceBuilder{
+		    borrowed_context, driver, serial, STEAM_INSTALL_DIR, vr::TrackedDeviceClass_TrackingReference});
+		device = references[slot].get();
+	}
+	// The reference is visible to synchronous and worker-thread callbacks in Activate.
+	const auto error = driver->Activate(reference_index_begin + slot);
+	if (error != vr::VRInitError_None) {
+		CTX_WARN("Activating tracking reference %s failed: %u", serial, error);
+		// OpenVR only requires Deactivate after successful activation. Serialize
+		// removal against callbacks; never reuse this failed index.
+		std::lock_guard lk(devices_mut);
+		references[slot].reset();
+		return false;
+	}
+	{
+		std::lock_guard lk(devices_mut);
+		device->activated = true;
+	}
+	CTX_INFO("Activated diagnostic base station %s at index %u", serial, reference_index_begin + slot);
+	return true;
+}
