@@ -0,0 +1,182 @@
+// Copyright 2026, OpenAI
+// SPDX-License-Identifier: BSL-1.0
+#include "interfaces/context.hpp"
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+#include <iostream>
+#include <thread>
+
+#define CHECK(condition)                                                                                               \
+	do {                                                                                                           \
+		if (!(condition)) {                                                                                    \
+			std::cerr << __LINE__ << ": " #condition "\n";                                                 \
+			std::abort();                                                                                  \
+		}                                                                                                      \
+	} while (0)
+
+struct Driver : vr::ITrackedDeviceServerDriver
+{
+	Context *host{};
+	uint32_t index{vr::k_unTrackedDeviceIndexInvalid};
+	unsigned activations{}, deactivations{};
+	bool fail{};
+	vr::EVRInitError
+	Activate(uint32_t idx) override
+	{
+		++activations;
+		index = idx;
+		const auto container = host->TrackedDeviceToPropertyContainer(idx);
+		CHECK(container == idx + 1);
+		uint64_t universe = 1234567890123456789ULL;
+		vr::PropertyWrite_t write{};
+		write.prop = vr::Prop_CurrentUniverseId_Uint64;
+		write.writeType = vr::PropertyWrite_Set;
+		write.unTag = vr::k_unUint64PropertyTag;
+		write.pvBuffer = &universe;
+		write.unBufferSize = sizeof(universe);
+		CHECK(host->WritePropertyBatch(container, &write, 1) == vr::TrackedProp_Success);
+		uint64_t value{};
+		vr::PropertyRead_t read{};
+		read.prop = write.prop;
+		read.pvBuffer = &value;
+		read.unBufferSize = sizeof(value);
+		CHECK(host->ReadPropertyBatch(container, &read, 1) == vr::TrackedProp_Success);
+		CHECK(value == universe);
+		CHECK(read.unTag == write.unTag);
+		vr::DriverPose_t pose{};
+		pose.qRotation.w = pose.qWorldFromDriverRotation.w = pose.qDriverFromHeadRotation.w = 1;
+		pose.poseIsValid = pose.deviceIsConnected = true;
+		pose.result = vr::TrackingResult_Running_OK;
+		pose.qRotation.z = pose.qRotation.w = std::sqrt(0.5);
+		pose.qWorldFromDriverRotation.y = pose.qWorldFromDriverRotation.w = std::sqrt(0.5);
+		pose.vecPosition[0] = 2;
+		pose.vecDriverFromHeadTranslation[0] = 1;
+		pose.vecWorldFromDriverTranslation[0] = 10;
+		pose.vecWorldFromDriverTranslation[1] = 20;
+		pose.vecWorldFromDriverTranslation[2] = 30;
+		host->TrackedDevicePoseUpdated(idx, pose, sizeof(pose));
+		// Joining this thread deadlocks if Activate was called with devices_mut held.
+		std::thread callback([&] {
+			CHECK(host->TrackedDeviceToPropertyContainer(idx) == container);
+			host->TrackedDevicePoseUpdated(idx, pose, sizeof(pose));
+		});
+		callback.join();
+		vr::VRInputComponentHandle_t handle{};
+		CHECK(host->CreateHapticComponent(container, "/output/haptic", &handle) ==
+		      vr::VRInputError_InvalidHandle);
+		CHECK(host->CreateSkeletonComponent(container, "/skeleton/hand/left", "/skeleton/hand/left", "",
+		                                    vr::VRSkeletalTracking_Full, nullptr, 0,
+		                                    &handle) == vr::VRInputError_InvalidHandle);
+		return fail ? vr::VRInitError_Driver_Failed : vr::VRInitError_None;
+	}
+	void
+	Deactivate() override
+	{
+		++deactivations;
+		CHECK(host->TrackedDeviceToPropertyContainer(index) == index + 1);
+	}
+	void
+	EnterStandby() override
+	{}
+	void *
+	GetComponent(const char *) override
+	{
+		return nullptr;
+	}
+	void
+	DebugRequest(const char *, char *, uint32_t) override
+	{}
+	vr::DriverPose_t
+	GetPose() override
+	{
+		return {};
+	}
+};
+
+struct Provider : vr::IServerTrackedDeviceProvider
+{
+	Context *host{};
+	Driver *first{};
+	bool cleaned{};
+	vr::EVRInitError
+	Init(vr::IVRDriverContext *context) override
+	{
+		host = dynamic_cast<Context *>(context);
+		CHECK(host);
+		return vr::VRInitError_None;
+	}
+	void
+	Cleanup() override
+	{
+		CHECK(!first || first->deactivations == 1);
+		cleaned = true;
+	}
+	const char *const *
+	GetInterfaceVersions() override
+	{
+		return nullptr;
+	}
+	void
+	RunFrame() override
+	{}
+	bool
+	ShouldBlockStandbyMode() override
+	{
+		return false;
+	}
+	void
+	EnterStandby() override
+	{}
+	void
+	LeaveStandby() override
+	{}
+};
+
+int
+main(int argc, char **argv)
+{
+	const bool enabled = argc > 1 && std::strcmp(argv[1], "on") == 0;
+	setenv("LH_DIAGNOSTIC_REFERENCES", enabled ? "1" : "0", 1);
+	Provider provider;
+	Driver drivers[18];
+	auto context = Context::create("/nonexistent-lh-test", "/nonexistent-lh-test", {&provider});
+	CHECK(context);
+	for (auto &driver : drivers)
+		driver.host = context.get();
+	auto add = [&](int i, const char *serial) {
+		return context->TrackedDeviceAdded(serial, vr::TrackedDeviceClass_TrackingReference, &drivers[i]);
+	};
+	CHECK(add(0, "reference-0") == enabled);
+	if (enabled) {
+		provider.first = &drivers[0];
+		CHECK(drivers[0].index == 17);
+		CHECK(!add(1, "reference-0"));
+		CHECK(drivers[1].activations == 0);
+		drivers[1].fail = true;
+		CHECK(!add(1, "failed-reference"));
+		CHECK(drivers[1].index == 18);
+		CHECK(context->TrackedDeviceToPropertyContainer(18) == vr::k_ulInvalidPropertyContainer);
+		vr::DriverPose_t ignored{};
+		context->TrackedDevicePoseUpdated(18, ignored, sizeof(ignored));
+		context->TrackedDevicePoseUpdated(UINT32_MAX, ignored, sizeof(ignored));
+		context->TrackedDevicePoseUpdated(17, ignored, 1);
+		for (int i = 2; i < 16; ++i)
+			CHECK(add(i, ("reference-" + std::to_string(i)).c_str()));
+		CHECK(drivers[15].index == 32);
+		CHECK(!add(16, "over-capacity"));
+		CHECK(drivers[16].activations == 0);
+		for (uint32_t i = 0; i <= 16; ++i)
+			CHECK(context->TrackedDeviceToPropertyContainer(i) == vr::k_ulInvalidPropertyContainer);
+		context->in_setup = false;
+		CHECK(!add(17, "late-reference"));
+		CHECK(drivers[17].activations == 0);
+	} else {
+		CHECK(drivers[0].activations == 0);
+		CHECK(context->TrackedDeviceToPropertyContainer(17) == vr::k_ulInvalidPropertyContainer);
+	}
+	context.reset();
+	CHECK(provider.cleaned);
+	for (int i = 0; i < 18; ++i)
+		CHECK(drivers[i].deactivations == unsigned(enabled && (i == 0 || (i >= 2 && i < 16))));
+}
