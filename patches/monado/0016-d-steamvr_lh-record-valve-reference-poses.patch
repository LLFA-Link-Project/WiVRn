From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenAI Codex <codex@openai.com>
Date: Mon, 12 Oct 2026 12:00:00 +0900
Subject: [PATCH] d/steamvr_lh: passively record raw Valve reference poses

---

diff --git a/src/xrt/drivers/CMakeLists.txt b/src/xrt/drivers/CMakeLists.txt
index 5ec99108b..1046cdf87 100644
--- a/src/xrt/drivers/CMakeLists.txt
+++ b/src/xrt/drivers/CMakeLists.txt
@@ -638,6 +638,7 @@ if(XRT_BUILD_DRIVER_STEAMVR_LIGHTHOUSE)
 		drv_steamvr_lh STATIC
 		steamvr_lh/steamvr_lh.cpp
 		steamvr_lh/device.cpp
+		steamvr_lh/reference_recorder.cpp
 		steamvr_lh/interfaces/driver_manager.cpp
