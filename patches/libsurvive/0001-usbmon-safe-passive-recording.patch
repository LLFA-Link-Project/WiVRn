From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenAI Codex <codex@openai.com>
Date: Mon, 12 Oct 2026 12:00:00 +0900
Subject: [PATCH] usbmon: preserve payloads, report drops and support passive capture

---

diff --git a/src/driver_usbmon.c b/src/driver_usbmon.c
index 0858e5c..8a3b8f2 100644
--- a/src/driver_usbmon.c
+++ b/src/driver_usbmon.c
@@ -19,6 +19,7 @@
 
 #include <zlib.h>
 
+STATIC_CONFIG_ITEM(USBMON_STATS, "usbmon-stats", 's', "JSON capture statistics output", 0)
 STATIC_CONFIG_ITEM(USBMON_RECORD, "usbmon-record", 's', "File to save .pcap to.", 0)
 STATIC_CONFIG_ITEM(USBMON_PLAYBACK, "usbmon-playback", 's', "File to replay .pcap from.", 0)
 STATIC_CONFIG_ITEM(USBMON_RECORD_ALL, "usbmon-record-all", 'b', "Whether or not to record all usb traffic", 0)
@@ -254,7 +255,17 @@ static int usbmon_close(struct SurviveContext *ctx, void *_driver) {
 	SurviveDriverUSBMon *driver = _driver;
 
 	struct pcap_stat stats = {0};
-	pcap_stats(driver->pcap, &stats);
+	int stats_result = pcap_stats(driver->pcap, &stats);
+	int write_error = driver->pcapDumper && pcap_dump_flush(driver->pcapDumper) != 0;
+	const char *stats_file = survive_configs(ctx, "usbmon-stats", SC_GET, 0);
+	if (stats_file && *stats_file) {
+		FILE *f = fopen(stats_file, "w");
+		if (f) {
+			fprintf(f, "{\"schema_version\":1,\"stats_available\":%s,\"received\":%u,\"dropped\":%u,\"interface_dropped\":%u,\"write_error\":%s}\n",
+			        stats_result == 0 ? "true" : "false", stats.ps_recv, stats.ps_drop, stats.ps_ifdrop, write_error ? "true" : "false");
+			fclose(f);
+		}
+	}
 
 	SV_INFO("usbmon saw %u/%u packets, %u dropped, %u dropped in driver in %.2f seconds (%.2fs runtime)",
 			(uint32_t)driver->packet_cnt, stats.ps_recv, stats.ps_drop, stats.ps_ifdrop, driver->time_now,
@@ -287,9 +298,9 @@ static usb_info_t *get_usb_info_from_file(const char *fname) {
 }
 
 #ifdef HIDAPI
-static usb_info_t *get_usb_info_from_os() { return 0; }
+static usb_info_t *get_usb_info_from_os(bool read_serial) { return 0; }
 #else
-static usb_info_t *get_usb_info_from_os() {
+static usb_info_t *get_usb_info_from_os(bool read_serial) {
 	usb_info_t *rtn = 0;
 
 	libusb_context *context = NULL;
@@ -317,7 +328,7 @@ static usb_info_t *get_usb_info_from_os() {
 									 .bus_id = libusb_get_bus_number(device),
 									 .dev_id = libusb_get_device_address(device)};
 
-		if (desc.iSerialNumber != 0) {
+		if (read_serial && desc.iSerialNumber != 0) {
 			libusb_device_handle *handle;
 			int error = libusb_open(device, &handle);
 			if (error >= 0) {
@@ -412,7 +423,7 @@ static int setup_usb_devices(SurviveDriverUSBMon *sp) {
 		sprintf(fname, "%s.usbdevs", usbmon_playback);
 		usbInfo = get_usb_info_from_file(fname);
 	} else {
-		usbInfo = get_usb_info_from_os();
+		usbInfo = get_usb_info_from_os(!survive_configi(ctx, "usbmon-only-record", SC_GET, 0));
 	}
 
 	sp->usb_devices_cnt = fill_device_inst(ctx, sp->usb_devices, usbInfo, listing_file);
@@ -451,8 +462,12 @@ static int setup_usb_devices(SurviveDriverUSBMon *sp) {
 	return rtn;
 }
 
+// libpcap 1.11 uses four-byte-aligned wrapper types for these ABI fields.
+static uint64_t usb_u64(const void *field) { uint64_t value; memcpy(&value, field, sizeof(value)); return value; }
+static int64_t usb_i64(const void *field) { int64_t value; memcpy(&value, field, sizeof(value)); return value; }
+
 double make_time(double start, const struct _usb_header_mmapped *pMmapped) {
-	return pMmapped->ts_sec + pMmapped->ts_usec * 1.e-6 - start;
+	return usb_i64(&pMmapped->ts_sec) + pMmapped->ts_usec * 1.e-6 - start;
 }
 
 const char *requestTypeToStr(uint8_t requestType) {
@@ -498,7 +513,7 @@ static double survive_usbmon_playback_run_time(const SurviveContext *ctx, void *
 const uint8_t *fill_usb_header(const void *_hdr, struct pcap_pkthdr *pkthdr, pcap_usb_header_mmapped *usbp) {
 	const USBPCAP_BUFFER_PACKET_HEADER *hdr = _hdr;
 
-	usbp->id = hdr->irpId;
+	memcpy(&usbp->id, &hdr->irpId, sizeof(hdr->irpId));
 	usbp->event_type = 0; // ???
 	usbp->transfer_type = hdr->transfer;
 	usbp->endpoint_number = hdr->endpoint;
@@ -509,7 +524,8 @@ const uint8_t *fill_usb_header(const void *_hdr, struct pcap_pkthdr *pkthdr, pca
 	usbp->urb_len = 0; // ???
 	usbp->data_len = hdr->dataLength;
 	usbp->data_flag = hdr->dataLength == 0;
-	usbp->ts_sec = pkthdr->ts.tv_sec;
+	int64_t ts_sec = pkthdr->ts.tv_sec;
+	memcpy(&usbp->ts_sec, &ts_sec, sizeof(ts_sec));
 	usbp->ts_usec = pkthdr->ts.tv_usec;
 
 	usbp->setup_flag = 1;
@@ -555,6 +571,7 @@ void *pcap_thread_fn(void *_driver) {
 
 		switch (result) {
 		case 0:
+			OGUSleep(1000);
 			goto continue_loop;
 		case 1: {
 			const uint8_t *pktData = 0;
@@ -562,17 +579,27 @@ void *pcap_thread_fn(void *_driver) {
 				pktData = fill_usb_header(hdr, pkthdr, &usbpcap_translation);
 				usbp = &usbpcap_translation;
 			} else {
+				if (pkthdr->caplen < sizeof(*usbp)) { SV_WARN("Short USB header skipped"); goto continue_loop; }
 				usbp = hdr;
 				// Packet data is directly after the packet header
 				pktData = (uint8_t *)&usbp[1];
 			}
 
+			uint64_t urb_id = usb_u64(&usbp->id);
 			vive_device_inst_t *dev = find_device_inst(driver, usbp->bus_id, usbp->device_address);
 
 			if (driver->pcapDumper && (dev || driver->record_all)) {
 				pcap_dump((uint8_t *)driver->pcapDumper, pkthdr, (uint8_t *)usbp);
+				if (ferror(pcap_dump_file(driver->pcapDumper))) {
+					SV_ERROR(SURVIVE_ERROR_HARWARE_FAULT, "usbmon capture write failed"); goto continue_loop;
+				}
 			}
 
+			if (driver->record_only) { if (dev) driver->packet_cnt++; goto continue_loop; }
+			if (driver->datalink == DLT_USB_LINUX_MMAPPED &&
+			    usbp->data_len > pkthdr->caplen - sizeof(*usbp)) {
+				SV_WARN("Truncated USB payload skipped during replay"); goto continue_loop;
+			}
 			if (dev) {
 				driver->packet_cnt++;
 				const char *dev_name = dev->name;
@@ -600,10 +627,10 @@ void *pcap_thread_fn(void *_driver) {
 				}
 
 #define COLORIZED_ID_STR SURVIVE_COLORIZED_FORMAT("%016lx")
-#define COLORIZED_ID SURVIVE_COLORIZED_DATA(usbp->id)
+#define COLORIZED_ID SURVIVE_COLORIZED_DATA(urb_id)
 				char color_set[16] = "";
 
-				unsigned hash = ((usbp->id + (usbp->id >> 8) + (usbp->id >> 16) + (usbp->id >> 24)) & 0xFF) % 8;
+				unsigned hash = ((usb_u64(&usbp->id) + (usb_u64(&usbp->id) >> 8) + (usb_u64(&usbp->id) >> 16) + (usb_u64(&usbp->id) >> 24)) & 0xFF) % 8;
 				sprintf(color_set, "\033[0;%dm", (int)(hash + 30));
 				const char *color_reset = "\033[0m";
 				driver->time_now = this_time;
@@ -618,7 +645,7 @@ void *pcap_thread_fn(void *_driver) {
 						dev->compressed_data_idx = 0;
 						SV_VERBOSE(200, "%s start of config", color_dev_name);
 					} else if (is_config_request(usbp)) {
-						dev->last_config_id = usbp->id;
+						dev->last_config_id = usb_u64(&usbp->id);
 					} else if (is_command_setup(usbp)) {
 						SV_INFO("%s sent command 0x%02x with %u bytes:", color_dev_name, pktData[1], pktData[2]);
 						survive_dump_buffer(ctx, pktData + 3, pktData[2]);
@@ -629,7 +656,7 @@ void *pcap_thread_fn(void *_driver) {
 											" event_type: %c transfer_type: %d bmRequestType: 0x%02x "
 											"bRequest: 0x%02x (%s) "
 											"wValue: 0x%04x wIndex: 0x%04x wLength: %4d (%4d)\n",
-											this_time, color_dev_name, SURVIVE_COLORIZED_DATA(usbp->id),
+											this_time, color_dev_name, SURVIVE_COLORIZED_DATA(urb_id),
 											usbp->event_type, usbp->transfer_type, usbp->s.setup.bmRequestType,
 											usbp->s.setup.bRequest, requestTypeToStr(usbp->s.setup.bRequest),
 											usbp->s.setup.wValue, usbp->s.setup.wIndex, usbp->s.setup.wLength,
@@ -654,14 +681,14 @@ void *pcap_thread_fn(void *_driver) {
 							SURVIVE_INVOKE_HOOK(printf, ctx,
 												"<-- %10.6f C: %s " COLORIZED_ID_STR
 												" event_type: %c transfer_type: %d 0x%02x (0x%02x):\n",
-												this_time, color_dev_name, SURVIVE_COLORIZED_DATA(usbp->id),
+												this_time, color_dev_name, SURVIVE_COLORIZED_DATA(urb_id),
 												usbp->event_type, usbp->transfer_type, usbp->endpoint_number,
 												usbp->data_len);
 						} else {
 							SURVIVE_INVOKE_HOOK(printf, ctx,
 												"--> %10.6f W: %s " COLORIZED_ID_STR
 												" event_type: %c transfer_type: %d 0x%02x (0x%02x):\n",
-												this_time, color_dev_name, SURVIVE_COLORIZED_DATA(usbp->id),
+												this_time, color_dev_name, SURVIVE_COLORIZED_DATA(urb_id),
 												usbp->event_type, usbp->transfer_type, usbp->endpoint_number,
 												usbp->data_len);
 						}
@@ -680,11 +707,11 @@ void *pcap_thread_fn(void *_driver) {
 							SURVIVE_INVOKE_HOOK(printf, ctx,
 												"<-- %10.6f E: %s " COLORIZED_ID_STR
 												" event_type: %c transfer_type: %d status: %d endpoint: 0x%02x (%s)\n",
-												this_time, color_dev_name, SURVIVE_COLORIZED_DATA(usbp->id),
+												this_time, color_dev_name, SURVIVE_COLORIZED_DATA(urb_id),
 												usbp->event_type, usbp->transfer_type, usbp->status,
 												usbp->endpoint_number, survive_usb_interface_str(interface));
 					}
-					if (usbp->id == dev->last_config_id) {
+					if (usb_u64(&usbp->id) == dev->last_config_id) {
 						dev->last_config_id = 0;
 					}
 					survive_release_ctx_lock(ctx);
@@ -700,7 +727,7 @@ void *pcap_thread_fn(void *_driver) {
 					SURVIVE_INVOKE_HOOK(printf, ctx,
 										"<-- %10.6f R: %s " COLORIZED_ID_STR
 										" event_type: %c transfer_type: %d endpoint: 0x%02x (%s) (0x%02x): \n",
-										this_time, color_dev_name, SURVIVE_COLORIZED_DATA(usbp->id), usbp->event_type,
+										this_time, color_dev_name, SURVIVE_COLORIZED_DATA(urb_id), usbp->event_type,
 										usbp->transfer_type, usbp->endpoint_number,
 										survive_usb_interface_str(interface), usbp->data_len);
 					survive_dump_buffer(ctx, pktData, usbp->data_len);
@@ -710,7 +737,7 @@ void *pcap_thread_fn(void *_driver) {
 					survive_usb_feature_read(dev->so, pktData, usbp->data_len);
 				}
 
-				if (usbp->id == dev->last_config_id && usbp->event_type == 'C' && dev->hasConfiged == false) {
+				if (usb_u64(&usbp->id) == dev->last_config_id && usbp->event_type == 'C' && dev->hasConfiged == false) {
 					ingest_config_request(dev, usbp, pktData);
 					dev->last_config_id = 0;
 					dev->packets_without_config = 0;
@@ -738,7 +765,7 @@ void *pcap_thread_fn(void *_driver) {
 					si.actual_len = usbp->data_len;
 					memset(si.buffer, 0xCA, sizeof(si.swap_buffer));
 					memcpy(si.buffer, pktData, usbp->data_len);
-					uint64_t time = usbp->ts_sec * 1000000 + usbp->ts_usec;
+					uint64_t time = usb_i64(&usbp->ts_sec) * 1000000 + usbp->ts_usec;
 					survive_data_cb(time, &si);
 				} else if (!dev->hasConfiged) {
 					if (driver->allow_fs_read && dev->packets_without_config++ > 1000 &&
@@ -824,6 +851,7 @@ static int DriverRegUSBMon_(SurviveContext *ctx, int driver_id) {
 	sp->playback_factor = -1;
 	sp->ctx = ctx;
 	sp->passiveMode = !enable && driver_id == 1;
+	if (survive_configi(ctx, "usbmon-only-record", SC_GET, 0)) sp->passiveMode = true;
 	if (sp->passiveMode) {
 		SV_INFO("Starting usbmon in passive (record) mode.");
 	} else {
@@ -847,7 +875,7 @@ static int DriverRegUSBMon_(SurviveContext *ctx, int driver_id) {
 #endif
 		survive_install_run_time_fn(ctx, survive_usbmon_playback_run_time, sp);
 	} else {
-		sp->pcap = pcap_open_live("usbmon0", PCAP_ERRBUF_SIZE, 0, -1, sp->errbuf);
+		sp->pcap = pcap_open_live("usbmon0", 65535, 0, 100, sp->errbuf);
 	}
 
 	if (sp->pcap == NULL) {
@@ -861,6 +889,10 @@ static int DriverRegUSBMon_(SurviveContext *ctx, int driver_id) {
 		return SURVIVE_DRIVER_ERROR;
 	}
 
+	if (!isPlaybackMode && pcap_setnonblock(sp->pcap, 1, sp->errbuf) != 0) {
+		SV_ERROR(SURVIVE_ERROR_HARWARE_FAULT, "Cannot make usbmon nonblocking: %s", sp->errbuf);
+		pcap_close(sp->pcap); free(sp); return SURVIVE_DRIVER_ERROR;
+	}
 	sp->datalink = pcap_datalink(sp->pcap);
 	if (sp->datalink != DLT_USBPCAP && sp->datalink != DLT_USB_LINUX_MMAPPED) {
 		SV_ERROR(SURVIVE_ERROR_INVALID_CONFIG, "USBMON driver does not support datalink type %d", sp->datalink);
@@ -874,8 +906,10 @@ static int DriverRegUSBMon_(SurviveContext *ctx, int driver_id) {
 
 	if (usbmon_record && *usbmon_record) {
 		FILE *fd = open_playback(usbmon_record, "w");
+		if (!fd) { SV_ERROR(SURVIVE_ERROR_HARWARE_FAULT, "Cannot open usbmon output"); pcap_close(sp->pcap); free(sp); return SURVIVE_DRIVER_ERROR; }
 		SV_INFO("Opening %s for usb recording (%p)", usbmon_record, (void *)fd);
 		sp->pcapDumper = pcap_dump_fopen(sp->pcap, fd);
+		if (!sp->pcapDumper) { fclose(fd); pcap_close(sp->pcap); free(sp); return SURVIVE_DRIVER_ERROR; }
 		sp->record_all = survive_configi(ctx, "usbmon-record-all", SC_GET, 0);
 		if (sp->record_all) {
 			SV_WARN("All USB traffic is being captured. Don't use 'usbmon-record-all' if you don't want to expose "
